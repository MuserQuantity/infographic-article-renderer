# LLM Configuration
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_SECONDS=0
# Set to 0 to disable request timeout (wait indefinitely for non-streaming responses)
# Total attempts = LLM_MAX_RETRIES + 1
LLM_MAX_RETRIES=9
LLM_RETRY_BASE_DELAY=1
LLM_RETRY_MAX_DELAY=8
LLM_USE_RESPONSE_FORMAT=true
# Max continuation rounds when LLM output is truncated (finish_reason=length)
# Set to 0 to disable continue mode
LLM_MAX_CONTINUATIONS=5
# Dual-model architecture: long text uses Model A (analysis) + Model B (formatting)
# Set to false to use single-model mode for all content
LLM_DUAL_MODEL_ENABLED=true
# Threshold (chars) above which dual-model is used. Set to 0 to always use dual-model.
LLM_DUAL_MODEL_THRESHOLD=15000
# Formatter model (Model B), leave empty to use the same model as LLM_MODEL_NAME
LLM_FORMATTER_MODEL_NAME=
# Chunking: content exceeding this threshold (chars) is split into chunks for processing.
# Set to 0 to disable chunking.
LLM_CHUNK_THRESHOLD=50000
# Target size per chunk (chars)
LLM_CHUNK_SIZE=15000

# Crawl4AI Configuration
CRAWL4AI_URL=http://your-crawl4ai-host:11235
# Max content length after cleaning (chars). 0 = no limit.
# Content is cleaned (nav/ads removed) then truncated at paragraph boundary if still too long.
CRAWL_CONTENT_MAX_LENGTH=50000

# PocketBase Configuration
POCKETBASE_URL=http://your-pocketbase-host:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your-admin-password

# Dify Configuration
DIFY_BASE_URL=https://api.dify.ai
DIFY_API_KEY=your-dify-api-key
DIFY_USER=infographic

# Frontend Configuration (passed as build arg via docker-compose)
# Set to "true" to use @antv/infographic for rendering, "false" to use legacy React components
VITE_USE_ANTV_INFOGRAPHIC=false
